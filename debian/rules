#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CXXFLAGS_MAINT_APPEND = -Wno-sign-compare -Wno-unused-variable -Wno-unused-but-set-variable

%:
	dh $@

# libmmp has no stable API/ABI yet, so build it as a static library only
# and link the viewer against it.
override_dh_auto_configure:
	dh_auto_configure -- --disable-shared --enable-sound

override_dh_auto_install:
	dh_auto_install
	find debian/tmp -name '*.la' -delete
