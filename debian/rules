#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CXXFLAGS_MAINT_APPEND = -Wno-sign-compare -Wno-unused-variable -Wno-unused-but-set-variable

%:
	dh $@ --buildsystem=meson

# libmmp has no stable API/ABI yet, so it is built as a static library only
# (meson default_library=static) and the viewer links against it.
override_dh_auto_configure:
	dh_auto_configure -- -Dsound=enabled -Dgui=enabled

# Remove leftovers of the former autotools build system (in-tree
# ./configure && make from older versions), which are not part of the source.
override_dh_auto_clean:
	dh_auto_clean
	rm -rf autom4te.cache build-aux
	rm -f config.status config.log config.h stamp-h1 libtool aclocal.m4 configure src/pmx
	find . -path ./debian -prune -o -path ./.git -prune -o \
	    \( -name Makefile -o -name Makefile.in -o -name '*.o' -o -name '*.lo' -o -name '*.la' -o -name '*.a' \) \
	    -type f -print0 | xargs -0r rm -f
	find . -path ./debian -prune -o -path ./.git -prune -o \
	    \( -name .deps -o -name .libs \) -type d -print0 | xargs -0r rm -rf
