# Unit tests (no OpenGL needed) and the rendering comparison test.
#
# The test model and motions are generated by gen_testdata.py into the build
# directory (third-party MMD data cannot be shipped).

glm_helper_test = executable('glm_helper_test', 'glm_helper_test.cpp',
  dependencies : libmmp_dep)
test('glm_helper', glm_helper_test, suite : 'unit')

python3 = find_program('python3', required : false)
if not python3.found()
  warning('python3 not found: the loader, motion and rendering tests are disabled')
  subdir_done()
endif

testdata = custom_target('testdata',
  input : 'gen_testdata.py',
  output : ['test_model.pmx', 'test_model.pmd', 'test_motion.vmd',
            'test_camera.vmd', 'tex.bmp'],
  command : [python3, '@INPUT@', '@OUTDIR@'],
  build_by_default : true)
testdata_dir = meson.current_build_dir()

loader_test = executable('loader_test', 'loader_test.cpp',
  dependencies : libmmp_dep)
test('loader', loader_test, args : [testdata_dir], depends : testdata,
  suite : 'unit', timeout : 120)

motion_test = executable('motion_test', 'motion_test.cpp',
  dependencies : libmmp_dep)
test('motion', motion_test, args : [testdata_dir], depends : testdata,
  suite : 'unit')

# Rendering: pmx --snapshot under X (Xvfb is started when there is no
# display; the test is skipped when neither is available) compared with
# the reference images in test/reference.
imgdiff = executable('imgdiff', 'imgdiff.cpp', dependencies : stb_dep)
render_args = [files('render_test.py'), '--pmx', pmx_exe, '--imgdiff', imgdiff,
               '--data', testdata_dir,
               '--reference', meson.current_source_dir() / 'reference',
               '--output', meson.current_build_dir() / 'render',
               '--source', meson.project_source_root()]
test('render', python3, args : render_args,
  depends : [testdata, pmx_exe, imgdiff],
  suite : 'render', timeout : 300)

# meson compile -C build update-reference-images
run_target('update-reference-images',
  command : [python3, render_args, '--update'],
  depends : [testdata, pmx_exe, imgdiff])
